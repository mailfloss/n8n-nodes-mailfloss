#!/bin/sh
# Wired by `npm run hooks` (sets core.hooksPath=.githooks for this clone and its worktrees).
# Refuses a commit that fails lint (n8n's scanner rules), typecheck/build or tests,
# then runs the machine-wide secret scan this hooksPath would otherwise skip.
set -e
npm run --silent lint
npm test --silent
global_hooks=$(git config --global core.hooksPath || true)
if [ -n "$global_hooks" ] && [ -x "$global_hooks/pre-commit" ]; then
	"$global_hooks/pre-commit"
elif command -v gitleaks >/dev/null 2>&1; then
	gitleaks protect --staged --redact --no-banner
fi
